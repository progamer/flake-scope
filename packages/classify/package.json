{
  "name": "@codept/flakescope-classify",
  "version": "0.1.0",
  "description": "Deterministic classification of Playwright flaky and failing tests from a flake-report.json.",
  "license": "MIT",
  "author": "Issa Khalil",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/progamer/flake-scope.git",
    "directory": "packages/classify"
  },
  "homepage": "https://github.com/progamer/flake-scope#readme",
  "bugs": {
    "url": "https://github.com/progamer/flake-scope/issues"
  },
  "keywords": [
    "playwright",
    "flaky-tests",
    "flaky",
    "test-analysis",
    "testing",
    "ci",
    "github-actions",
    "e2e"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@codept/flakescope-reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.0",
    "vitest": "5.0.1"
  }
}
