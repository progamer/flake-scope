{
  "name": "@flakescope/classify",
  "version": "0.0.0",
  "description": "Deterministic classification of Playwright flaky and failing tests from a flake-report.json.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@flakescope/reporter": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^6.0.0",
    "vitest": "5.0.1"
  }
}
