{
  "name": "flakescope",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" run build",
    "test": "pnpm build && pnpm -r --filter \"./packages/**\" run test",
    "typecheck": "pnpm build && pnpm -r --filter \"./packages/**\" run typecheck",
    "demo": "pnpm build && pnpm --filter demo run test:ci"
  }
}
